nano run_feature_counts_all.sbatch

##### run_feature_counts_all.sbatch
#!/bin/bash
#SBATCH --job-name=GSF4595_counts
#SBATCH --partition=general
#SBATCH --account=r01267
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=/N/slate/yl278/GSF4595/slurm_logs/featurecounts_%j.out
#SBATCH --error=/N/slate/yl278/GSF4595/slurm_logs/featurecounts_%j.err

set -euo pipefail
cd /N/slate/yl278/GSF4595

source /N/soft/rhel8/conda/26.3.2/etc/profile.d/conda.sh
conda activate /N/slate/yl278/rna-seq

declare -A BAM_FOR_SAMPLE=()
shopt -s nullglob

for DIR in star_results star_results_sbatch; do
    for BAM in "$DIR"/*_Aligned.sortedByCoord.out.bam; do
        SAMPLE=$(basename "$BAM" _Aligned.sortedByCoord.out.bam)
        LOG="$DIR/${SAMPLE}_Log.final.out"

        # 只纳入有 STAR 成功日志的 BAM。
        [[ -s "$LOG" ]] || continue

        if [[ -n "${BAM_FOR_SAMPLE[$SAMPLE]+x}" ]]; then
            echo "ERROR: duplicate completed BAM for $SAMPLE" >&2
            exit 1
        fi

        BAM_FOR_SAMPLE["$SAMPLE"]="$BAM"
    done
done

if (( ${#BAM_FOR_SAMPLE[@]} != 18 )); then
    echo "ERROR: expected 18 completed samples, found ${#BAM_FOR_SAMPLE[@]}" >&2
    exit 1
fi

BAMS=()
for SAMPLE in "${!BAM_FOR_SAMPLE[@]}"; do
    BAMS+=("${BAM_FOR_SAMPLE[$SAMPLE]}")
done

srun featureCounts \
  -a genome/annotation.gtf \
  -o feature_counts_results_sbatch/all_samples_counts.txt \
  -t gene \
  -g gene_id \
  --largestOverlap \
  --primary \
  -p --countReadPairs \
  -s 2 \
  -T "$SLURM_CPUS_PER_TASK" \
  "${BAMS[@]}"

echo "featureCounts finished"

#####

# submit the sbatch
sbatch --dependency="afterok:${ARRAY_JOB}" run_feature_counts_all.sbatch

